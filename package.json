{
  "name": "payku-monitor-operaciones",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Function que consulta indicadores operacionales y los publica en Cloud Monitoring",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "start": "functions-framework --target=publishIndicators --signature-type=http",
    "dev": "functions-framework --target=publishIndicators --signature-type=http --port=8080"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.5.1",
    "@google-cloud/monitoring": "^5.3.1",
    "dotenv": "^17.2.3",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7"
  }
}
